# range.env — single source of truth for every script in scripts/
# cp range.env.example range.env  &&  edit  &&  chmod 600 range.env
# NEVER commit range.env (see .gitignore)

# --- network ---------------------------------------------------------------
RANGE_NET=agentlab0
RANGE_CIDR=10.66.0.0/16
RANGE_IP_RANGE=10.66.1.0/24          # dynamic pool: agent-runner, range-idp; statics live outside
PROBE_CIDR=10.66.0.248/29            # probe containers -> Wazuh self-test rule (L3), never paged
AGENT_SRC_RE='^10\.66\.1\.'        # containment-timer: t0 only from the dynamic pool
COMPOSE_FILE=range/compose.yml

# --- probe image (MUST be pulled by preflight, network is --internal) -------
PROBE_IMAGE=curlimages/curl:8.11.0

# --- tripwire / simulation domains -----------------------------------------
TRIPWIRE_DOMAIN=canary.tripwire-range.invalid
SIM_CA_DOMAIN=ca.sim.invalid
SIM_CA_PATH=/usr/local/share/ca-certificates/sim-range-ca.crt

# --- canary accounts --------------------------------------------------------
CANARY_CONTAINER=range-idp
CANARY_USERS="svc-legacy backup-admin ctf-canary"

# --- Wazuh (Sigma rule verification, level B = authoritative) --------------
WAZUH_HOST=127.0.0.1
WAZUH_PORT=55000
WAZUH_USER=range-probe-ro        # least privilege: policy rules_read only
WAZUH_PASS=CHANGE_ME
WAZUH_CONTAINER=wazuh-wazuh.manager-1
WAZUH_API_PIN=                     # sha256//<base64>; API cert valid to 2027-09-26
SIGMA_ID_MIN=100200
SIGMA_ID_MAX=100299
# exact number of containment rules that MUST be loaded — a range check is not
# falsifiable, an exact count is
SIGMA_EXPECTED=8        # Detection Pack v1: 100200-100206 + 100220

# --- killswitch -------------------------------------------------------------
KILL_CHAIN=RANGE-KILL

# --- probe timeouts ---------------------------------------------------------
PROBE_TIMEOUT=5
