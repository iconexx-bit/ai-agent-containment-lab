# range.env — configuration for every script in scripts/
# cp range.env.example range.env  &&  edit  &&  chmod 600 range.env
# NEVER commit range.env (see .gitignore)
# Loaded ONLY by scripts/lib/env.sh (load_range_env). An EXPORTED variable overrides this file in
# default-mode scripts (probe, verdict, lint-rules, logtest, preflight) and is named on stderr;
# strict scripts (range-up, range-down, killswitch, containment-timer, negatives, break-* recipes)
# refuse an export that differs from this file (exit 2) — change the value here instead.
# range-up exit: 0 PASS, 1 FAIL, 2 configuration (range.env / skip), 4 network not contained,
#                70 infrastructure / collector error

# --- network ---------------------------------------------------------------
RANGE_NET=agentlab0
RANGE_CIDR=10.66.0.0/16
RANGE_IP_RANGE=10.66.1.0/24          # dynamic pool: agent-runner, range-idp; statics live outside
PROBE_CIDR=10.66.0.248/29            # probe containers -> Wazuh self-test rule (L3), never paged
AGENT_SRC_RE='^10\.66\.1\.'        # containment-timer: t0 only from the dynamic pool
COMPOSE_FILE=range/compose.yml       # same default in every script (tests/test-repo-consistency.sh)

# --- probe image (MUST be pulled by preflight, network is --internal) -------
PROBE_IMAGE=curlimages/curl:8.11.0

# --- tripwire / simulation domains -----------------------------------------
TRIPWIRE_DOMAIN=canary.tripwire-range.invalid
SIM_CA_DOMAIN=ca.sim.invalid
SIM_CA_PATH=/usr/local/share/ca-certificates/sim-range-ca.crt

# --- canary accounts --------------------------------------------------------
CANARY_CONTAINER=range-idp
CANARY_USERS="svc-legacy backup-admin ctf-canary"

# --- Wazuh (Sigma rule verification, level B = authoritative) --------------
WAZUH_HOST=127.0.0.1
WAZUH_PORT=55000
WAZUH_USER=range-probe-ro        # least privilege: policy rules_read only
WAZUH_PASS=CHANGE_ME
WAZUH_CONTAINER=wazuh-wazuh.manager-1
WAZUH_API_PIN=                     # REQUIRED: sha256//<base64> of the API key; unset or malformed ->
                                   # sigma fails with NO API call (fail closed)
SIGMA_ID_MIN=100200
SIGMA_ID_MAX=100299
# REQUIRED, no default: exact number of containment rules your manager MUST have loaded — a range
# check is not falsifiable, an exact count is. Unset -> sigma fails "unset"; not a positive
# integer -> "malformed"; both before any API call. Detection Pack v1: 100200-100206 + 100220.
SIGMA_EXPECTED=8

# --- killswitch -------------------------------------------------------------
KILL_CHAIN=RANGE-KILL

# --- probe timeouts ---------------------------------------------------------
PROBE_TIMEOUT=5

# --- operator skips (scripts/lib/skip.sh); check ids: egress tripwire sigma canaries sim_ca ----
# VERDICT_SKIP="sigma"   # verdict reports these as SKIP (operator), never PASS; negatives: UNPROVEN
# NEG_SKIP=""            # negatives.sh does not break these; the verdict still judges them
# Unknown id -> exit 2. PROBE_SKIP is retired -> exit 2. Controls with no safe negative are code,
# not config: scripts/lib/no-neg.sh (each with a reason).
