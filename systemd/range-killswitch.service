# /etc/systemd/system/range-killswitch.service
# Re-arms the killswitch when docker.service starts and the marker is set. Its real job is a host reboot:
# iptables starts empty while the marker in /var/lib survives. Docker itself keeps DOCKER-USER across a
# daemon restart (O17, Docker 29.6.1). Proven by `just verify-persistence` phase B (O24).
[Unit]
Description=Re-arm agent range killswitch after docker restart
After=docker.service
BindsTo=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=RANGE_CIDR=10.66.0.0/16
Environment=KILL_CHAIN=RANGE-KILL
Environment=RANGE_KILL_MARKER=/var/lib/range-lab/killswitch.armed
ExecStart=/usr/local/bin/range-killswitch-arm.sh

[Install]
WantedBy=docker.service
